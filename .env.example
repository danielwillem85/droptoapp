# DropToApp server settings. Copy this file to ".env" and fill it in.
# .env holds secrets: it is in .gitignore, never commit it.

# --- Brevo newsletter ------------------------------------------------------
# API key: Brevo > Settings (top right) > SMTP & API > API Keys > Generate a new API key
BREVO_API_KEY=
# List number: Brevo > Contacts > Lists; the ID is shown next to each list
BREVO_LIST_ID=
# Whether the newsletter box on the registration form starts ticked
NEWSLETTER_CHECKED_BY_DEFAULT=false

# --- Server ----------------------------------------------------------------
PORT=3000
HOST=127.0.0.1
# SQLite database with the user accounts (created automatically)
DATABASE_PATH=data/droptoapp.db
# Log-in lasts this many days
SESSION_DAYS=30

# --- Production (behind nginx with HTTPS) -----------------------------------
# Public address of the site, used for search engines and link previews
# (canonical link, og:image, sitemap.xml). No trailing slash.
SITE_URL=
# Only send the login cookie over HTTPS
COOKIE_SECURE=false
# Take the visitor's IP from nginx's X-Real-IP header (used for rate limiting)
TRUST_PROXY=false
